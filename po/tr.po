msgstr "{format} seçilemiyor: {reason}"

#: src/dialogs/erase.cpp
msgid "The passphrases don't match."
msgstr "Parolalar eşleşmiyor."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "A Master Boot Record reaches only the first {reach} of “{name}”; the other {rest} stay unused. Choose GUID Partition Map to use all of it."
msgstr "Ana Önyükleme Kaydı (MBR), “{name}” diskinin yalnızca ilk {reach} kadarlık kısmına erişebilir; kalan {rest} kullanılmadan kalır. Tamamını kullanmak için GUID Bölümlendirme Haritası'nı seçin."

#: src/dialogs/erase.cpp
msgid "The data is overwritten with zeros first, which takes as long as writing the whole volume once."
msgstr "Verilerin üzerine önce sıfırlar yazılır; bu işlem tüm birime bir kez veri yazmak kadar sürer."

#: src/dialogs/erase.cpp
msgid "Quick Erase"
msgstr "Hızlı Sil"

#: src/dialogs/erase.cpp
msgid "Zero Out Data"
msgstr "Verilerin Üzerine Sıfır Yaz"

