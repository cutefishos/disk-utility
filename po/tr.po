#, python-brace-format
msgid "Checking “{name}”…"
msgstr "“{name}” denetleniyor…"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is no longer there. Skipped."
msgstr "“{name}” artık mevcut değil. Atlandı."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is locked. Unlock it to check it. Skipped."
msgstr "“{name}” kilitli. Denetlemek için kilidini açın. Atlandı."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” holds no file system First Aid can check. Skipped."
msgstr "“{name}”, İlk Yardım'ın denetleyebileceği bir dosya sistemi barındırmıyor. Atlandı."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Checking “{name}” ({device}, {format})."
msgstr "“{name}” ({device}, {format}) denetleniyor."

#: src/dialogs/firstaid.cpp
msgid "unknown format"
msgstr "bilinmeyen biçim"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "UDisks2 could not tell whether {format} volumes can be checked. Try again later."
msgstr "UDisks2, {format} birimlerinin denetlenip denetlenemeyeceğini belirleyemedi. Daha sonra tekrar deneyin."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be checked: {tool} is not installed."
msgstr "{format} birimleri denetlenemiyor: {tool} kurulu değil."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Unmounting “{name}”."
msgstr "“{name}” ayrılıyor."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use and can’t be unmounted. Close the files and quit the programs using it, then run First Aid again."
msgstr "“{name}” kullanımda ve ayrılamıyor. Dosyaları kapatın, birimi kullanan programlardan çıkın ve İlk Yardım'ı tekrar çalıştırın."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” is in use by {programs} and can’t be unmounted. Close their files on it or quit them, then run First Aid again."
msgstr "“{name}”, {programs} tarafından kullanılıyor ve ayrılamıyor. İlgili dosyaları kapatın veya programlardan çıkın, ardından İlk Yardım'ı tekrar çalıştırın."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be unmounted: {message}"
msgstr "“{name}” ayrılamadı: {message}"

#: src/dialogs/firstaid.cpp
msgid "Checking the file system."
msgstr "Dosya sistemi denetleniyor."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The check failed: {message}"
msgstr "Denetim başarısız oldu: {message}"

