msgid "Another copy is in progress."
msgstr "Başka bir kopyalama işlemi devam ediyor."

#: src/dialogs/diskimages.cpp
msgid "Wait for it to finish, or stop it first."
msgstr "Bitmesini bekleyin veya önce durdurun."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erase “{name}”"
msgstr "“{name}” Öğesini Sil"

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes every volume on it and everything stored on them. This can't be undone. Choose a name, a format and a partition scheme for it."
msgstr "“{name}” öğesini silmek üzerindeki tüm birimleri ve içlerindeki her şeyi siler. Bu işlem geri alınamaz. Bunun için bir ad, biçim ve bölümlendirme düzeni seçin."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "Erasing “{name}” deletes everything stored on it. This can't be undone. Choose a name and a format for it."
msgstr "“{name}” öğesini silmek üzerinde depolanan her şeyi siler. Bu işlem geri alınamaz. Bunun için bir ad ve biçim seçin."

