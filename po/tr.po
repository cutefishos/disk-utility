msgstr "Kalıbının oluşturulabilmesi için “{name}” ayrılmalıdır."

#: src/dialogs/diskimages.cpp
msgid "It is unmounted, and locked when it is encrypted, before it is read, and stays so afterwards."
msgstr "Okunmadan önce ayrılır (şifreliyse kilitlenir) ve işlem sonrasında da öyle kalır."

