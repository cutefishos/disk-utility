msgstr "UDisks2, {format} birimlerinin onarılıp onarılamayacağını belirleyemedi."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{format} volumes can’t be repaired: {tool} is not installed."
msgstr "{format} birimleri onarılamıyor: {tool} kurulu değil."

#: src/dialogs/firstaid.cpp
msgid "Repairing the file system."
msgstr "Dosya sistemi onarılıyor."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Repairing “{name}”…"
msgstr "“{name}” onarılıyor…"

#: src/dialogs/firstaid.cpp
msgid "The file system was repaired."
msgstr "Dosya sistemi onarıldı."

#: src/dialogs/firstaid.cpp
msgid "The file system could not be repaired."
msgstr "Dosya sistemi onarılamadı."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "The repair failed: {message}"
msgstr "Onarım başarısız oldu: {message}"

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "Mounting “{name}” again."
msgstr "“{name}” tekrar bağlanıyor."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "“{name}” could not be mounted again: {message}"
msgstr "“{name}” tekrar bağlanamadı: {message}"

#: src/dialogs/firstaid.cpp
msgid "First Aid was cancelled."
msgstr "İlk Yardım iptal edildi."

#: src/dialogs/firstaid.cpp
msgid "First Aid found errors it could not repair. Back up the data you can and erase the volume."
msgstr "İlk Yardım onaramadığı hatalar buldu. Kurtarabildiğiniz verileri yedekleyin ve birimi silin."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has failed."
msgstr "İlk Yardım işlemi başarısız oldu."

#: src/dialogs/firstaid.cpp
msgid "First Aid process has completed."
msgstr "İlk Yardım işlemi tamamlandı."

#: src/dialogs/firstaid.cpp
#, python-brace-format
msgid "{n} volume was skipped."
msgid_plural "{n} volumes were skipped."
msgstr[0] "{n} birim atlandı."
msgstr[1] "{n} birim atlandı."

#: src/dialogs/firstaid.cpp
msgid "First Aid"
msgstr "İlk Yardım"

