msgstr "“{name}” yalnızca kısmen silindi ve şu anda kullanılabilir bir birimi yok. Kullanmak için tekrar silin."

#: src/dialogs/erase.cpp
#, python-brace-format
msgid "“{name}” was not erased; nothing stored on it was changed."
msgstr "“{name}” silinmedi; üzerinde depolanan hiçbir şey değiştirilmedi."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was stopped before it finished."
msgstr "“{step}” tamamlanmadan durduruldu."

#: src/dialogs/erase.cpp src/dialogs/partition.cpp
#, python-brace-format
msgid "“{step}” was cancelled."
msgstr "“{step}” iptal edildi."

