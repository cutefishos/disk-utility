#, python-brace-format
msgid "The image cannot be saved on “{name}” itself. Choose a folder on another disk."
msgstr "Kalıp “{name}” üzerine kaydedilemez. Başka bir diskte bir klasör seçin."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "“{name}” holds the running system, so it cannot be unmounted to be read."
msgstr "“{name}” çalışan sistemi barındırıyor, bu nedenle okunmak üzere ayrılamaz."

#: src/dialogs/diskimages.cpp
#, python-brace-format
msgid "Creating “{name}”"
msgstr "“{name}” oluşturuluyor"

